# KODEX 반도체레버리지(494310) 시세 자동 수집 V1.2 (2026-10-08)
# 평일 15:07 · 15:47 · 18:17 (KST) 에 공공데이터포털(금융위원회 증권상품시세정보 V2, 공식 확정 일봉) + 네이버 금융(최신일 보충·대조)에서
# 일봉·현재가를 받아 data/kodex.json 에 저장합니다. 둘 다 실패하면 Yahoo.
# 인증키: 저장소 Settings → Secrets and variables → Actions → New repository secret
#        Name = DATA_GO_KR_KEY , Secret = 공공데이터포털 일반 인증키 (Encoding/Decoding 어느 쪽이든 가능)
#        Secret이 없으면 네이버만으로 동작합니다.
# 처음 한 번은 Actions 탭 → "KODEX 시세 수집" → Run workflow 로 직접 실행하세요.
name: KODEX 시세 수집

on:
  schedule:
    - cron: "7 6 * * 1-5"    # 15:07 KST  장중 현재가 (종가 단일가 주문 전 참고)
    - cron: "47 6 * * 1-5"   # 15:47 KST  종가 확정 직후
    - cron: "17 9 * * 1-5"   # 18:17 KST  재확인 (지연·누락 대비)
  workflow_dispatch:

permissions:
  contents: write

concurrency:
  group: kodex-data
  cancel-in-progress: false

jobs:
  fetch:
    runs-on: ubuntu-latest
    timeout-minutes: 5
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
      - name: 시세 받기
        env:
          DATA_GO_KR_KEY: ${{ secrets.DATA_GO_KR_KEY }}
        run: python scripts/fetch_kodex.py
      - name: 바뀌었으면 저장
        run: |
          git config user.name "kodex-data-bot"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git add data/kodex.json
          if git diff --cached --quiet; then
            echo "변경 없음"
          else
            git commit -m "KODEX 시세 자동 갱신 $(TZ=Asia/Seoul date '+%Y-%m-%d %H:%M') KST"
            git push
          fi
